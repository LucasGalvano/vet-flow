<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vetflow</groupId>
    <artifactId>vetflow-server</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ZeroMQ: implementacao pura Java (sem dependencia nativa de
             libzmq). Interoperabilidade com pyzmq (Python) confirmada via
             teste direto do protocolo ZMTP antes de escrever este pom. -->
        <dependency>
            <groupId>org.zeromq</groupId>
            <artifactId>jeromq</artifactId>
            <version>0.5.4</version>
        </dependency>

        <!-- MessagePack via Jackson: permite tratar o envelope como um
             Map<String,Object>, no mesmo espirito do dict usado no lado
             Python (msgpack.packb / unpackb). -->
        <dependency>
            <groupId>org.msgpack</groupId>
            <artifactId>jackson-dataformat-msgpack</artifactId>
            <version>0.9.8</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>vetflow-server</finalName>
        <plugins>
            <!-- Gera um "fat jar" (com todas as dependencias dentro), para
                 rodar com `java -jar vetflow-server.jar` sem precisar
                 montar classpath manualmente. Facilita tambem o Dockerfile
                 quando dockerizarmos. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.vetflow.server.Server</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>