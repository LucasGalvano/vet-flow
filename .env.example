# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente.
# ".env" NAO deve ser commitado (ver .gitignore); ".env.example" deve.
#
# Nenhuma dessas variaveis e obrigatoria hoje: o codigo tem valores padrao
# seguros (ver server.py / client.py) e funciona normalmente sem .env.
# Este arquivo serve para documentar o que pode ser configurado e para
# uso futuro com Docker Compose (env_file).

# --- Python Client (bot) ---
# Nome do bot que faz login no servidor.
BOT_NAME=bot-python-1

# Endereco do servidor ao qual o client se conecta.
SERVER_ADDRESS=tcp://localhost:5555

# --- Python Server ---
# Endereco/porta em que o servidor faz bind (REP socket).
SERVER_BIND_ADDRESS=tcp://*:5555

# --- Parte 2 (Pub/Sub) ---
# Client: endereco do XPUB do broker (ACTION=SUBSCRIBE), texto a publicar
# (ACTION=PUBLISH) e por quanto tempo escutar.
BROKER_ADDRESS=tcp://localhost:5558
MESSAGE=mensagem de teste
SUBSCRIBE_SECONDS=5

# Server: endereco do XSUB do broker (onde o PUB do servidor conecta) e
# caminho da persistencia das mensagens publicadas.
BROKER_XSUB_ADDRESS=tcp://localhost:5557
# MESSAGES_PERSISTENCE_PATH=python/server/data/messages.msgpack
